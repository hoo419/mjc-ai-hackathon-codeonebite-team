# OpenAI-compatible AI provider (used from the Chat API phase onward).
# Never commit the real .env file.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Phase 9: PostgreSQL. Leave empty to run entirely on Mock JSON (data/*.json)
# with no database at all. Ask 임채호 for the shared Neon connection string,
# or create your own free instance at https://neon.tech - either way, the
# app seeds itself from data/*.json automatically the first time it runs
# against an empty database.
DATABASE_URL=

# 배포 시(Railway 등)에만 필요. 로컬 개발용 localhost:3000은 기본으로 항상
# 허용되니 로컬 개발할 땐 비워둬도 된다. 배포된 프론트(Vercel) URL을
# 콤마로 구분해서 넣는다 (프리뷰 배포까지 여러 개면 여러 개 다).
CORS_EXTRA_ORIGINS=
